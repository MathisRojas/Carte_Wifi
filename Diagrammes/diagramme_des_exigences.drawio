        <mxCell id="b8uuXoH9fd0aGBLaR0QP-23" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&amp;lt;&amp;lt;requirement&amp;gt;&amp;gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;background-color: initial; text-align: start;&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Communication&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;background-color: initial; color: rgba(0, 0, 0, 0); font-family: monospace; font-size: 0px; text-align: start; text-wrap: nowrap;&quot;&gt;%3CmxGraphModel%3E%3Croot%3E%3CmxCell%20id%3D%220%22%2F%3E%3CmxCell%20id%3D%221%22%20parent%3D%220%22%2F%3E%3CmxCell%20id%3D%222%22%20value%3D%22%26lt%3Bp%20style%3D%26quot%3Bmargin%3A0px%3Bmargin-top%3A4px%3Btext-align%3Acenter%3B%26quot%3B%26gt%3B%26amp%3Blt%3B%26amp%3Blt%3Brequirement%26amp%3Bgt%3B%26amp%3Bgt%3B%26lt%3Bbr%26gt%3B%26lt%3Bb%26gt%3BArrosage%26amp%3Bnbsp%3Bautomatique%26lt%3B%2Fb%26gt%3B%26lt%3B%2Fp%26gt%3B%26lt%3Bhr%26gt%3B%26lt%3Bp%26gt%3B%26lt%3B%2Fp%26gt%3B%26lt%3Bp%20style%3D%26quot%3Bmargin%3A%200px%200px%200px%208px%3B%20text-align%3A%20left%3B%26quot%3B%26gt%3Bid%3D%26quot%3B1.1.1%26quot%3B%26lt%3B%2Fp%26gt%3B%26lt%3Bp%20style%3D%26quot%3Bmargin%3A0px%3Bmargin-left%3A8px%3Btext-align%3Aleft%3B%26quot%3B%26gt%3Btext%3D%26quot%3Bl&#39;utilisateur%20doit%20pouvoir%20r%C3%A9gler%20l&#39;arrosage%20en%20fonction%20de%20l&#39;humidit%C3%A9%20voulu%20pour%20le%20bon%20d%C3%A9veloppement%20de%20ces%20plantes%20et%20le%20r%C3%A9servoir%20du%20syst%C3%A8me%20d&#39;arrosage%20doit%20permettre%20une%20autonomie%20de%201-2%20semaines%20il%20doit%20faire%20entre%203-5%20litres%26quot%3B%26lt%3B%2Fp%26gt%3B%22%20style%3D%22shape%3Drect%3Boverflow%3Dfill%3Bhtml%3D1%3BwhiteSpace%3Dwrap%3Balign%3Dcenter%3BstrokeWidth%3D1%3BfillColor%3D%23f8cecc%3BstrokeColor%3D%23FF3333%3BgradientColor%3D%23FF3333%3B%22%20vertex%3D%221%22%20parent%3D%221%22%3E%3CmxGeometry%20x%3D%2280%22%20y%3D%22520%22%20width%3D%22210%22%20height%3D%22170%22%20as%3D%22geometry%22%2F%3E%3C%2FmxCell%3E%3C%2Froot%3E%3C%2FmxGraphModel%3E&lt;/span&gt;&lt;/div&gt;&lt;p&gt;&lt;/p&gt;&lt;hr&gt;&lt;p&gt;&lt;/p&gt;&lt;p style=&quot;margin: 0px 0px 0px 8px; text-align: left;&quot;&gt;id=&quot;1.1.1&quot;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left;&quot;&gt;text=&quot;&lt;span style=&quot;font-family: Calibri, sans-serif; background-color: initial; text-align: center;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;La liaison Wi-Fi devra être assurée par un module Wi-Fi ESP01&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&quot;&lt;/span&gt;&lt;/p&gt;" style="shape=rect;overflow=fill;html=1;whiteSpace=wrap;align=center;strokeWidth=1;fillColor=#f8cecc;strokeColor=#FF3333;gradientColor=#FF3333;" parent="1" vertex="1">
          <mxGeometry x="590" y="530" width="220" height="170" as="geometry" />
        </mxCell>
        <mxCell id="b8uuXoH9fd0aGBLaR0QP-24" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&amp;lt;&amp;lt;requirement&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;Contrôle des actionneurs&lt;/b&gt;&lt;span style=&quot;color: rgba(0, 0, 0, 0); font-family: monospace; font-size: 0px; text-align: start; text-wrap: nowrap; background-color: initial;&quot;&gt;%3CmxGraphModel%3E%3Croot%3E%3CmxCell%20id%3D%220%22%2F%3E%3CmxCell%20id%3D%221%22%20parent%3D%220%22%2F%3E%3CmxCell%20id%3D%222%22%20value%3D%22%26lt%3Bp%20style%3D%26quot%3Bmargin%3A0px%3Bmargin-top%3A4px%3Btext-align%3Acenter%3B%26quot%3B%26gt%3B%26amp%3Blt%3B%26amp%3Blt%3Brequirement%26amp%3Bgt%3B%26amp%3Bgt%3B%26lt%3Bbr%26gt%3B%26lt%3Bb%26gt%3BArrosage%26amp%3Bnbsp%3Bautomatique%26lt%3B%2Fb%26gt%3B%26lt%3B%2Fp%26gt%3B%26lt%3Bhr%26gt%3B%26lt%3Bp%26gt%3B%26lt%3B%2Fp%26gt%3B%26lt%3Bp%20style%3D%26quot%3Bmargin%3A%200px%200px%200px%208px%3B%20text-align%3A%20left%3B%26quot%3B%26gt%3Bid%3D%26quot%3B1.1.1%26quot%3B%26lt%3B%2Fp%26gt%3B%26lt%3Bp%20style%3D%26quot%3Bmargin%3A0px%3Bmargin-left%3A8px%3Btext-align%3Aleft%3B%26quot%3B%26gt%3Btext%3D%26quot%3Bl&#39;utilisateur%20doit%20pouvoir%20r%C3%A9gler%20l&#39;arrosage%20en%20fonction%20de%20l&#39;humidit%C3%A9%20voulu%20pour%20le%20bon%20d%C3%A9veloppement%20de%20ces%20plantes%20et%20le%20r%C3%A9servoir%20du%20syst%C3%A8me%20d&#39;arrosage%20doit%20permettre%20une%20autonomie%20de%201-2%20semaines%20il%20doit%20faire%20entre%203-5%20litres%26quot%3B%26lt%3B%2Fp%26gt%3B%22%20style%3D%22shape%3Drect%3Boverflow%3Dfill%3Bhtml%3D1%3BwhiteSpace%3Dwrap%3Balign%3Dcenter%3BstrokeWidth%3D1%3BfillColor%3D%23f8cecc%3BstrokeColor%3D%23FF3333%3BgradientColor%3D%23FF3333%3B%22%20vertex%3D%221%22%20parent%3D%221%22%3E%3CmxGeometry%20x%3D%2280%22%20y%3D%22520%22%20width%3D%22210%22%20height%3D%22170%22%20as%3D%22geometry%22%2F%3E%3C%2FmxCell%3E%3C%2Froot%3E%3C%2FmxGraphModel%3E&lt;/span&gt;&lt;/p&gt;&lt;hr&gt;&lt;p&gt;&lt;/p&gt;&lt;p style=&quot;margin: 0px 0px 0px 8px; text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;id=&quot;1.1.1&quot;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin: 0px 0px 0px 8px; text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;text=&quot;&lt;font style=&quot;&quot;&gt;Le contrôle des actionneurs est assuré par des relais, permettant de piloter une grande variété de systèmes, qu&#39;il s&#39;agisse de dispositifs domotiques en (AC) ou de petits dispositifs en (DC)&lt;/font&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin: 0px 0px 0px 8px; text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Capacité de commutation des contacts :&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Charge résistive AC : 250V AC, jusqu&#39;à 16A&quot;&lt;/span&gt;&lt;/p&gt;" style="shape=rect;overflow=fill;html=1;whiteSpace=wrap;align=center;strokeWidth=1;fillColor=#f8cecc;strokeColor=#FF3333;gradientColor=#FF3333;" parent="1" vertex="1">
          <mxGeometry x="180" y="530" width="210" height="230" as="geometry" />
        </mxCell>
