<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/134.0.0.0 Safari/537.36 Edg/134.0.0.0" version="26.1.1">
  <diagram name="Page-1" id="ca7pxn3QDtRuIXZrabN_">
    <mxGraphModel dx="2911" dy="1130" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="b8uuXoH9fd0aGBLaR0QP-1" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&amp;lt;&amp;lt;requirement&amp;gt;&amp;gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b style=&quot;background-color: initial;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Télécommande wifi&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr&gt;&lt;p&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;id=&quot;1&quot;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin: 0px 0px 0px 8px; text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;text=&quot;&lt;span style=&quot;background-color: initial;&quot;&gt;Concevoir un&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;module compact et autonome capable de piloter des actionneurs et de contrôler&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;des données de capteurs environnementaux via un microcontrôleur PIC18F26K22,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;avec une Application Wi-Fi depuis un téléphone portable ou un PC.&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&quot;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" style="shape=rect;overflow=fill;html=1;whiteSpace=wrap;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;gradientColor=#FFB570;" parent="1" vertex="1">
          <mxGeometry x="350" y="10" width="280" height="200" as="geometry" />
        </mxCell>
        <mxCell id="b8uuXoH9fd0aGBLaR0QP-2" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&amp;lt;&amp;lt;requirement&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;Alimentation/Autonomie&lt;/b&gt;&lt;/p&gt;&lt;hr&gt;&lt;p&gt;&lt;/p&gt;&lt;p style=&quot;margin: 0px 0px 0px 8px; text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;id=&quot;1.2&quot;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin: 0px 0px 0px 8px; text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;text=&quot;Le module doit avoir une faible consommation d’énergie afin de pouvoir être alimenté par une batterie et permettre un fonctionnement prolongé sans intervention fréquente pendant plusieurs semaines.&lt;span style=&quot;background-color: initial;&quot;&gt;&quot;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" style="shape=rect;overflow=fill;html=1;whiteSpace=wrap;align=center;strokeWidth=1;fillColor=#99FF99;strokeColor=#00FF00;" parent="1" vertex="1">
          <mxGeometry x="735" y="30" width="270" height="180" as="geometry" />
        </mxCell>
        <mxCell id="b8uuXoH9fd0aGBLaR0QP-3" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&amp;lt;&amp;lt;requirement&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;Structure&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;hr&gt;&lt;p&gt;&lt;/p&gt;&lt;p style=&quot;margin: 0px 0px 0px 8px; text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;id=&quot;1.3&quot;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin: 0px 0px 0px 8px; text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;text=&quot;&lt;span style=&quot;background-color: initial; text-align: center;&quot;&gt;&lt;font style=&quot;&quot;&gt;Le module doit être compact pour qu’il puisse être installé dans un boîtier, afin de rendre le module plus robuste. L’utilisation de connecteurs permettra de brancher différents types de capteurs et d&#39;actionneurs, et de rendre le module évolutif&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&quot;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" style="shape=rect;overflow=fill;html=1;whiteSpace=wrap;align=center;strokeWidth=1;fillColor=#99FF99;strokeColor=#00FF00;" parent="1" vertex="1">
          <mxGeometry x="-40" y="30" width="330" height="180" as="geometry" />
        </mxCell>
        <mxCell id="b8uuXoH9fd0aGBLaR0QP-4" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&amp;lt;&amp;lt;requirement&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;Pilotage des capteurs et actionneurs&lt;/b&gt;&lt;/p&gt;&lt;hr&gt;&lt;p&gt;&lt;/p&gt;&lt;p style=&quot;margin: 0px 0px 0px 8px; text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;id=&quot;1.1&quot;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin: 0px 0px 0px 8px; text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;text=&quot;Le module devra piloter des actionneurs et intégrer des capteurs (de température et d&#39;humidité) afin d&#39;informer l&#39;utilisateur des conditions environnementales du système via une application (PC et téléphone) par liaison Wi-Fi. L&#39;utilisateur pourra également piloter les actionneurs (relais) à distance grâce à cette application&lt;span style=&quot;background-color: initial;&quot;&gt;&quot;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" style="shape=rect;overflow=fill;html=1;whiteSpace=wrap;align=center;strokeWidth=1;fillColor=#99FF99;strokeColor=#00FF00;" parent="1" vertex="1">
          <mxGeometry x="320" y="260" width="340" height="200" as="geometry" />
        </mxCell>
